# PhysicalAgent / TARS Companion: Cloud API Configuration
# Copy this file to .env and populate your active API keys.
# The brain adapter automatically detects present keys and dynamically configures failover tiers.

# ==============================================================================
# Tier 1: Groq Cloud (Recommended: Ultra-fast inference & Whisper audio)
# Get a key at: https://console.groq.com/keys
# Models: whisper-large-v3-turbo, llama-3.3-70b-versatile, llama-3.2-11b-vision-preview
# ==============================================================================
GROQ_API_KEY=

# ==============================================================================
# Tier 2: Cloudflare Workers AI (Serverless edge whisper & multimodal vision)
# Get credentials at: https://dash.cloudflare.com/
# Models: @cf/openai/whisper, @cf/meta/llama-3.3-70b-instruct, @cf/meta/llama-3.2-11b-vision-instruct
# ==============================================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ==============================================================================
# Tier 3: OpenRouter Free Pool (Redundant multi-model safety net)
# Get a key at: https://openrouter.ai/keys
# Models: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
# ==============================================================================
OPENROUTER_API_KEY=

# ==============================================================================
# Tier 4: Google Gemini API (Burst multimodal pool)
# Get a key at: https://aistudio.google.com/app/apikey
# Models: gemini-2.5-flash
# ==============================================================================
GEMINI_API_KEY=

# ==============================================================================
# TARS Personality & Runtime Settings
# ==============================================================================
TARS_HUMOR_PERCENT=75
TARS_HONESTY_PERCENT=90
TARS_DEFAULT_VOICE=Samantha
